<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="generator" content="trag.dev-template (github.com/chris-trag/chris-trag.github.io)">

    <title>{{ title }}</title>

    {# Booth resource page; not for general indexing. #}
    <meta name="robots" content="noindex,nofollow">
    <meta name="googlebot" content="noindex,nofollow">

    <meta name="description" content="{% if description %}{{ description }}{% endif %}">
    <meta name="theme-color" content="#141D27">

    {# OpenGraph + Twitter for QR-share / Slack unfurls #}
    <meta property="og:title" content="{{ title }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://trag.dev{{ page.url }}">
    <meta property="og:image" content="{% if og_image %}{{ og_image }}{% else %}https://trag.dev/ftv/img/og-card.png{% endif %}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Fire TV Developer Resources">
    <meta property="og:description" content="{% if description %}{{ description }}{% endif %}">
    <meta property="og:site_name" content="trag.dev">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@chris_trag">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{% if description %}{{ description }}{% endif %}">
    <meta name="twitter:image" content="{% if og_image %}{{ og_image }}{% else %}https://trag.dev/ftv/img/og-card.png{% endif %}">

    {# Favicons - per-event Fire TV mark, not the trag.dev mark.
       Orange-bg vector SVG is 3KB pure-vector vs the old 32KB SVG that
       embedded a base64 PNG. Same visual, 90%+ smaller. #}
    <link rel="icon" href="/ftv/img/firetv-logo-orange.svg" type="image/svg+xml">
    <link rel="icon" href="/ftv/img/firetv-favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/ftv/img/firetv-favicon-180.png">

    <link rel="canonical" href="https://trag.dev{{ page.url }}">

    <link rel="stylesheet" href="/ftv/ftv.css">

    {# Detect Silk-on-Fire-TV before first paint so .tv overrides apply
       cleanly with no flash. Match: Silk/<ver> + AFT* device id (per
       https://docs.aws.amazon.com/silk/latest/developerguide/user-agent.html).
       AFT* covers all current Fire TV devices (AFTM/AFTS/AFTSS/AFTANL/AFTKA/etc.)
       and excludes Fire tablets (KFFOWI-style ids). #}
    <script>
        (function () {
            var ua = navigator.userAgent || "";
            if (/Silk\//.test(ua) && /\bAFT[A-Z0-9]+/.test(ua)) {
                document.documentElement.classList.add("tv");
            }
        })();
    </script>
</head>
<body class="linktree linktree-ftv">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9JFF8H9Z1P"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-9JFF8H9Z1P');
    </script>

    {# UTM params appended to every outbound link so GA4 attributes QR-driven traffic.
       Joined with `?` or `&` per URL - some destinations carry their own query string. #}
    {% set utm_params = "utm_source=qr-card&utm_medium=qr&utm_campaign=irl" %}

    <main class="ft-shell">
        <header class="ft-hero">
            <a class="ft-mark-link" href="https://amazon.com/firetv/?{{ utm_params }}" rel="noopener" target="_blank" aria-label="Fire TV at amazon.com">
                <img class="ft-mark" src="/ftv/img/firetv-logo-orange.svg" alt="Fire TV" width="120" height="120">
            </a>
            <h1 class="ft-title">
                {% for line in ftv.hero.title %}<span>{{ line }}</span>{% endfor %}
            </h1>
            <p class="ft-tagline">{{ ftv.hero.tagline }}</p>
        </header>

        <nav class="ft-links" aria-label="Resources">
            {% for link in ftv.links %}
                <a href="{{ link.url }}{% if '?' in link.url %}&{% else %}?{% endif %}{{ utm_params }}" class="ft-link" data-icon="{{ link.icon }}" rel="noopener" target="_blank">
                    <span class="ft-link-icon">{% include "icons/" + link.icon + ".njk" ignore missing %}</span>
                    <span class="ft-link-body">
                        <span class="ft-link-text">{{ link.text }}</span>
                        {% if link.sublabel %}<span class="ft-link-sub">{{ link.sublabel }}</span>{% endif %}
                    </span>
                    <span class="ft-link-arrow" aria-hidden="true">&#8599;</span>
                </a>
            {% endfor %}
        </nav>

        <footer class="ft-foot">
            <p class="ft-built-by">Built by <a href="https://trag.dev/?{{ utm_params }}">Chris Trag</a> for <a href="https://www.linkedin.com/showcase/amazon-appstore-developers/?{{ utm_params }}" rel="noopener" target="_blank">Amazon Developers</a></p>
        </footer>
    </main>

    {# Footer leaves graphic - full-width band centered at bottom of viewport #}
    <div class="ft-leaves-band" aria-hidden="true"></div>

    {# TV-only: corner QR overlay. Lets attendees transfer page to phone
       without touching the remote. Hidden on phone/desktop via CSS. #}
    <aside class="ft-qr" aria-label="QR code to open this page on phone">
        <span class="ft-qr-caption">Scan to Bookmark</span>
        <img src="/ftv/img/qr-corner.svg" alt="" width="180" height="180">
    </aside>

    {# Phone/desktop: tap-to-reveal QR. Subtle glyph in bottom-right; a click
       opens a small cream panel anchored above it (slide-presentation style).
       Hidden on TV mode where .ft-qr already provides a permanent overlay. #}
    <button type="button" class="ft-qr-toggle" aria-label="Show QR code for this page" aria-expanded="false" aria-controls="ft-qr-pop">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M0 0h7v7H0zM2 2h3v3H2zM17 0h7v7h-7zM19 2h3v3h-3zM0 17h7v7H0zM2 19h3v3H2z"/>
            <path d="M9 2h2v2H9zM13 2h2v2h-2zM11 5h2v2h-2zM9 9h2v2H9zM13 9h2v2h-2zM17 9h2v2h-2zM21 9h2v2h-2zM11 11h2v2h-2zM15 11h2v2h-2zM19 11h2v2h-2zM9 13h2v2H9zM13 13h2v2h-2zM17 13h2v2h-2zM21 13h2v2h-2zM9 17h2v2H9zM13 17h2v2h-2zM17 17h2v2h-2zM9 21h2v2H9zM13 21h2v2h-2zM17 21h2v2h-2zM21 21h2v2h-2z"/>
        </svg>
    </button>
    <div class="ft-qr-pop" id="ft-qr-pop" role="dialog" aria-label="Scan to open this page on your phone" hidden>
        <div class="ft-qr-pop-controls" role="group" aria-label="QR controls">
            <button type="button" class="ft-qr-pop-handle" aria-label="Drag to move (double-click to reset)" title="Drag to move - double-click to reset">
                <span aria-hidden="true">⋮⋮</span>
            </button>
            <div class="ft-qr-pop-sizes" role="group" aria-label="QR size">
                <button type="button" class="ft-qr-size" data-size="s" aria-label="Small">S</button>
                <button type="button" class="ft-qr-size" data-size="m" aria-pressed="true" aria-label="Medium">M</button>
                <button type="button" class="ft-qr-size" data-size="l" aria-label="Large">L</button>
            </div>
        </div>
        <img src="/ftv/img/qr-corner.svg" alt="QR code linking to this page" width="160" height="160">
        <span class="ft-qr-pop-caption">Scan to Bookmark</span>
    </div>

    <script>
        (function () {
            var toggle = document.querySelector(".ft-qr-toggle");
            var pop = document.querySelector(".ft-qr-pop");
            var handle = pop && pop.querySelector(".ft-qr-pop-handle");
            if (!toggle || !pop) return;

            var STORAGE_KEY = "ft-qr-pop-pos";
            var SIZE_KEY = "ft-qr-pop-size";
            var sizeButtons = pop.querySelectorAll(".ft-qr-size");

            function applySize(size) {
                pop.setAttribute("data-size", size);
                sizeButtons.forEach(function (btn) {
                    btn.setAttribute("aria-pressed", btn.dataset.size === size ? "true" : "false");
                });
                try { localStorage.setItem(SIZE_KEY, size); } catch (e) {}
                /* If pinned to a custom position, re-clamp so the resized
                   panel doesn't overflow the viewport */
                if (pop.style.left) {
                    var x = parseFloat(pop.style.left) || 0;
                    var y = parseFloat(pop.style.top) || 0;
                    /* Defer one frame so layout reflects the new size */
                    requestAnimationFrame(function () { setPixelPosition(x, y); });
                }
            }

            function applyStoredSize() {
                try {
                    var saved = localStorage.getItem(SIZE_KEY);
                    if (saved === "s" || saved === "m" || saved === "l") {
                        applySize(saved);
                        return;
                    }
                } catch (e) {}
                applySize("m");
            }

            sizeButtons.forEach(function (btn) {
                btn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    applySize(btn.dataset.size);
                });
            });

            function open() {
                pop.hidden = false;
                toggle.setAttribute("aria-expanded", "true");
                applyStoredSize();
                applyStoredPosition();
            }
            function close() {
                pop.hidden = true;
                toggle.setAttribute("aria-expanded", "false");
            }
            function isOpen() { return !pop.hidden; }

            /* Sticky popover: only the toggle button (or ESC) closes it.
               Click-outside-to-dismiss was removed because clicking link
               cards should NOT close the QR - the QR is meant to stay put
               while you interact with the page (cast/HDMI workflow). */
            toggle.addEventListener("click", function (e) {
                e.stopPropagation();
                isOpen() ? close() : open();
            });
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && isOpen()) {
                    close();
                    toggle.focus();
                }
            });

            /* ---- Drag-to-reposition ----
               Switches from right/bottom anchor to absolute left/top pixels
               while dragging. Position persists to localStorage. Double-click
               the handle to reset. Constrained so it can't leave the viewport. */
            function clamp(val, min, max) { return Math.max(min, Math.min(max, val)); }

            function setPixelPosition(x, y) {
                var rect = pop.getBoundingClientRect();
                var maxX = window.innerWidth - rect.width;
                var maxY = window.innerHeight - rect.height;
                x = clamp(x, 0, Math.max(0, maxX));
                y = clamp(y, 0, Math.max(0, maxY));
                pop.style.left = x + "px";
                pop.style.top = y + "px";
                pop.style.right = "auto";
                pop.style.bottom = "auto";
            }

            function applyStoredPosition() {
                try {
                    var raw = localStorage.getItem(STORAGE_KEY);
                    if (!raw) return;
                    var pos = JSON.parse(raw);
                    if (typeof pos.x === "number" && typeof pos.y === "number") {
                        setPixelPosition(pos.x, pos.y);
                    }
                } catch (e) { /* ignore corrupt storage */ }
            }

            function resetPosition() {
                pop.style.left = "";
                pop.style.top = "";
                pop.style.right = "";
                pop.style.bottom = "";
                try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
            }

            if (handle) {
                var dragging = false;
                var pointerId = null;
                var offsetX = 0, offsetY = 0;

                handle.addEventListener("pointerdown", function (e) {
                    if (e.button !== undefined && e.button !== 0) return; /* primary button only */
                    var rect = pop.getBoundingClientRect();
                    offsetX = e.clientX - rect.left;
                    offsetY = e.clientY - rect.top;
                    dragging = true;
                    pointerId = e.pointerId;
                    pop.classList.add("ft-qr-pop--dragging");
                    /* Capture pointer so we keep getting events even if it leaves the handle */
                    try { handle.setPointerCapture(pointerId); } catch (err) {}
                    e.preventDefault();
                });

                handle.addEventListener("pointermove", function (e) {
                    if (!dragging || e.pointerId !== pointerId) return;
                    setPixelPosition(e.clientX - offsetX, e.clientY - offsetY);
                });

                function endDrag(e) {
                    if (!dragging || (e && e.pointerId !== pointerId)) return;
                    dragging = false;
                    pop.classList.remove("ft-qr-pop--dragging");
                    try { handle.releasePointerCapture(pointerId); } catch (err) {}
                    /* Persist the final position */
                    var rect = pop.getBoundingClientRect();
                    try {
                        localStorage.setItem(STORAGE_KEY, JSON.stringify({ x: rect.left, y: rect.top }));
                    } catch (err) {}
                }
                handle.addEventListener("pointerup", endDrag);
                handle.addEventListener("pointercancel", endDrag);

                /* Double-click handle to reset to default corner */
                handle.addEventListener("dblclick", function (e) {
                    e.preventDefault();
                    resetPosition();
                });

                /* Block click bubbling on the handle so dragging doesn't close the popover */
                handle.addEventListener("click", function (e) { e.stopPropagation(); });
            }

            /* Re-clamp on resize so the popover never ends up off-screen
               after switching monitors or resizing the window */
            window.addEventListener("resize", function () {
                if (!isOpen() || !pop.style.left) return;
                var x = parseFloat(pop.style.left) || 0;
                var y = parseFloat(pop.style.top) || 0;
                setPixelPosition(x, y);
            });
        })();
    </script>

    {# TV-only: autofocus + cardinal D-pad spatial navigation.
       Arrow keys move focus to the spatially-nearest focusable element,
       not DOM order. Works with the grid layout in CSS. #}
    <script>
        if (document.documentElement.classList.contains("tv")) {
            document.addEventListener("DOMContentLoaded", function () {
                var first = document.querySelector(".ft-link");
                if (first) first.focus({ preventScroll: true });

                var KEYS = { ArrowUp: "up", ArrowDown: "down", ArrowLeft: "left", ArrowRight: "right" };
                document.addEventListener("keydown", function (e) {
                    var dir = KEYS[e.key];
                    if (!dir) return;
                    var active = document.activeElement;
                    if (!active || active === document.body) return;
                    var nodes = Array.prototype.slice.call(
                        document.querySelectorAll(".ft-link, .ft-mark-link, .ft-foot a")
                    );
                    if (nodes.indexOf(active) === -1) return;
                    var a = active.getBoundingClientRect();
                    var ax = a.left + a.width / 2, ay = a.top + a.height / 2;
                    var best = null, bestScore = Infinity;
                    nodes.forEach(function (n) {
                        if (n === active) return;
                        var b = n.getBoundingClientRect();
                        var bx = b.left + b.width / 2, by = b.top + b.height / 2;
                        var dx = bx - ax, dy = by - ay;
                        // Reject candidates not in the requested direction
                        if (dir === "up" && dy >= -8) return;
                        if (dir === "down" && dy <= 8) return;
                        if (dir === "left" && dx >= -8) return;
                        if (dir === "right" && dx <= 8) return;
                        // Score: primary axis distance + perpendicular penalty
                        var primary = (dir === "up" || dir === "down") ? Math.abs(dy) : Math.abs(dx);
                        var perp = (dir === "up" || dir === "down") ? Math.abs(dx) : Math.abs(dy);
                        var score = primary + perp * 2;
                        if (score < bestScore) { bestScore = score; best = n; }
                    });
                    if (best) { e.preventDefault(); best.focus(); }
                });
            });
        }
    </script>
</body>
</html>
